import re
text = """My email is student123@gmail.com,my phone number is 9876543210,and my website is https://www.example.com."""
email_pattern = r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b'
email_match = re.search(email_pattern, text)
if email_match:
    print("Email found:", email_match.group())
phone_pattern = r'\b\d{10}\b'
phone_match = re.search(phone_pattern, text)
if phone_match:
    print("Phone number found:", phone_match.group())
url_pattern = r'https?://[^\s]+'
url_match = re.search(url_pattern, text)
if url_match:
    print("URL found:", url_match.group())
word_pattern = r'\w*\d+\w*'
words = re.findall(word_pattern, text)
print("Words containing digits:", words)
